{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        {
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
        }
      ]
    },
    "accountBindingId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "routeGeneration": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "message.received",
        "message.edited",
        "message.deleted"
      ]
    },
    "providerChatId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        {
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
        }
      ]
    },
    "providerMessageId": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[^\\uD800-\\uDFFF]*$"
        },
        {
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
        }
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ]
    },
    "sourceVariant": {
      "type": "string",
      "enum": [
        "complete",
        "placeholder"
      ]
    },
    "nativeMessageKeyVersion": {
      "type": "number",
      "const": 1
    },
    "occurredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourcePosition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                },
                {
                  "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
                }
              ]
            },
            "value": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                },
                {
                  "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
                }
              ]
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                },
                {
                  "pattern": "^[^\\u0000]{0,65536}$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceAuthorId": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                },
                {
                  "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceDisplayName": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                },
                {
                  "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "sourceAuthorId",
        "sourceDisplayName"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "accountBindingId",
    "routeGeneration",
    "kind",
    "providerChatId",
    "providerMessageId",
    "direction",
    "sourceVariant",
    "nativeMessageKeyVersion",
    "occurredAt",
    "sourcePosition",
    "payload"
  ],
  "additionalProperties": false
}
