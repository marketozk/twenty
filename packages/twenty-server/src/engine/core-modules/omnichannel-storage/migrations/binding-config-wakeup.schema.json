    "checks": [
      {
        "name": "CHK_omniBindingConfigWakeup_counters",
        "expression": "((\"handlerVersion\" > 0) AND (attempts >= 0) AND (\"leaseToken\" >= 0))"
      },
      {
        "name": "CHK_omniBindingConfigWakeup_cursor",
        "expression": "((\"cursorNextAttemptAt\" IS NULL) = (\"cursorReceiptId\" IS NULL))"
      },
      {
        "name": "CHK_omniBindingConfigWakeup_error",
        "expression": "((\"errorCode\" IS NULL) OR (\"errorCode\" = ANY (ARRAY['binding_inactive'::text, 'unsupported_handler'::text, 'rescan_required'::text, 'transient_failure'::text])))"
      },
      {
        "name": "CHK_omniBindingConfigWakeup_generation",
        "expression": "((\"observedRouteGeneration\" IS NULL) OR (\"observedRouteGeneration\" > 0))"
      },
      {
        "name": "CHK_omniBindingConfigWakeup_lease",
        "expression": "(((state = 'running'::text) AND (\"leaseOwner\" IS NOT NULL) AND (\"leaseUntil\" IS NOT NULL) AND (\"leaseToken\" > 0)) OR ((state <> 'running'::text) AND (\"leaseOwner\" IS NULL) AND (\"leaseUntil\" IS NULL)))"
      },
      {
        "name": "CHK_omniBindingConfigWakeup_state",
        "expression": "(state = ANY (ARRAY['pending'::text, 'running'::text, 'retryable'::text, 'completed'::text, 'blocked'::text]))"
      }
    ],
