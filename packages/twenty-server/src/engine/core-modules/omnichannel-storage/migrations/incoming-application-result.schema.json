    "checks": [
      {
        "name": "CHK_omniIncomingReceipt_application_result",
        "expression": "((\"applicationResult\" IS NULL) OR (((state = 'applied'::text) AND (\"resultId\" IS NOT NULL) AND (jsonb_typeof(\"applicationResult\") = 'object'::text) AND ((\"applicationResult\" -> 'schemaVersion'::text) = '1'::jsonb) AND ((\"applicationResult\" ->> 'kind'::text) = 'incoming_text_revision'::text) AND ((\"applicationResult\" ->> 'disposition'::text) = ANY (ARRAY['created'::text, 'advanced'::text, 'duplicate'::text, 'stale'::text]))) IS TRUE))"
      },
      {
        "name": "CHK_omniIncomingReceipt_counters",
        "expression": "((\"schemaVersion\" > 0) AND (\"routeGeneration\" > 0) AND (attempts >= 0) AND (\"leaseToken\" >= 0))"
      },
      {
        "name": "CHK_omniIncomingReceipt_hash",
        "expression": "(\"canonicalPayloadHash\" ~ '^[a-f0-9]{64}$'::text)"
      },
      {
        "name": "CHK_omniIncomingReceipt_identity",
        "expression": "((length(\"eventId\") > 0) AND (length(kind) > 0))"
      },
      {
        "name": "CHK_omniIncomingReceipt_lease",
        "expression": "(((\"leaseOwner\" IS NULL) = (\"leaseUntil\" IS NULL)) AND ((state <> 'processing'::text) OR ((\"leaseOwner\" IS NOT NULL) AND (\"leaseToken\" > 0))))"
      },
      {
        "name": "CHK_omniIncomingReceipt_state",
        "expression": "(state = ANY (ARRAY['accepted'::text, 'processing'::text, 'applied'::text, 'retryable_error'::text, 'blocked_config'::text, 'quarantined'::text]))"
      },
      {
        "name": "CHK_omniIncomingReceipt_trusted_capture",
        "expression": "(((\"trustedCaptureContext\" IS NULL) AND (\"trustedCaptureContextHash\" IS NULL)) OR ((\"trustedCaptureContext\" IS NOT NULL) AND (\"trustedCaptureContextHash\" IS NOT NULL) AND (jsonb_typeof(\"trustedCaptureContext\") = 'object'::text) AND (\"trustedCaptureContextHash\" ~ '^[a-f0-9]{64}$'::text)))"
      }
    ],
