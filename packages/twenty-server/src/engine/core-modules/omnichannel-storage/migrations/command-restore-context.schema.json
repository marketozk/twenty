    "checks": [
      {
        "name": "CHK_omniOutgoingCommand_ai_producer",
        "expression": "((\"senderClass\" <> 'ai_turn'::text) OR (\"producerTurnId\" IS NOT NULL))"
      },
      {
        "name": "CHK_omniOutgoingCommand_counters",
        "expression": "((generation > 0) AND (\"policyVersion\" >= 0) AND (\"outboundSequence\" > 0) AND (\"statusRevision\" > 0) AND ((\"expectedAutomationEpoch\" IS NULL) OR (\"expectedAutomationEpoch\" > 0)) AND ((\"journalSequence\" IS NULL) OR (\"journalSequence\" >= 0)))"
      },
      {
        "name": "CHK_omniOutgoingCommand_identity",
        "expression": "((length(\"actorKind\") > 0) AND (length(\"actorId\") > 0) AND (length(\"initiatingActorId\") > 0) AND (length(\"idempotencyKey\") > 0) AND (length(\"senderClass\") > 0) AND (length(\"contentProvenance\") > 0))"
      },
      {
        "name": "CHK_omniOutgoingCommand_lease",
        "expression": "(((\"leaseToken\" IS NULL) AND (\"leaseUntil\" IS NULL)) OR ((\"leaseToken\" IS NOT NULL) AND (\"leaseUntil\" IS NOT NULL)))"
      },
      {
        "name": "CHK_omniOutgoingCommand_nonHuman_context",
        "expression": "((\"senderClass\" = 'human'::text) OR ((\"referenceId\" IS NOT NULL) AND (\"expectedAutomationEpoch\" IS NOT NULL)))"
      },
      {
        "name": "CHK_omniOutgoingCommand_payload",
        "expression": "((jsonb_typeof(payload) = 'object'::text) AND (jsonb_typeof(\"workflowCancellationRefs\") = 'array'::text))"
      },
      {
        "name": "CHK_omniOutgoingCommand_payloadHash",
        "expression": "(\"payloadHash\" ~ '^[a-f0-9]{64}$'::text)"
      },
      {
        "name": "CHK_omniOutgoingCommand_producer_fence",
        "expression": "(((\"producerTurnId\" IS NULL) AND (\"capturedTurnFence\" IS NULL)) OR ((\"producerTurnId\" IS NOT NULL) AND (\"capturedTurnFence\" IS NOT NULL) AND (\"capturedTurnFence\" > 0)))"
      },
      {
        "name": "CHK_omniOutgoingCommand_replacement",
        "expression": "((\"replacesCommandId\" IS NULL) OR ((\"replacesCommandId\" <> id) AND (\"senderClass\" = 'human'::text)))"
      },
      {
        "name": "CHK_omniOutgoingCommand_reply_snapshot",
        "expression": "(((\"replyToMessageLinkId\" IS NULL) AND (\"resolvedReplyNativeRef\" IS NULL)) OR ((\"replyToMessageLinkId\" IS NOT NULL) AND (\"resolvedReplyNativeRef\" IS NOT NULL) AND (jsonb_typeof(\"resolvedReplyNativeRef\") = 'object'::text)))"
      },
      {
        "name": "CHK_omniOutgoingCommand_state",
        "expression": "(state = ANY (ARRAY['pending'::text, 'dispatching'::text, 'accepted'::text, 'outcome_unknown'::text, 'sent'::text, 'failed'::text, 'cancelled'::text]))"
      }
    ],
